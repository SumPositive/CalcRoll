# fastlane snapshot 設定（Calclin / カルメモ）
# ------------------------------------------------------------
# 撮影カット（電卓の状態違い・達人モードで撮影）:
#   01Calculator … 電卓モード（左から順に計算）
#   02Formula    … 数式モード（優先順位あり）
#   03TwoPanels  … 電卓パネル2面の2連状態
# UITest は1回起動して UI を操作しながら 3 枚撮る。
#
# App Store 必須サイズ:
#   - iPhone 6.9": iPhone 17 Pro Max（1320x2868）
#   - iPad 13":    iPad Pro 13-inch (M5)  … 審査必須枠
#
# 【注意】devices([...]) の名前は `xcrun simctl list devices` に出る名前と一致必須。

# iPhone 6.9" と iPad 13" の両方を撮る。
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# 片方だけ撮りたい場合はどちらかをコメントアウトする。

# 言語コード = 出力フォルダ名（App Store のロケール名に一致させる）かつ -AppleLanguages。
# 言語切替は SnapshotHelper が language.txt（=この値）で行う。値は Calclin の
# .lproj 名と一致させること（Calclin は en / ja のみ対応）。
# ※ App Store のロケール名は英語が "en-US"。SnapshotHelper は先頭2文字(en)で
#    .lproj を解決するため、フォルダ名 en-US のままで言語切替は正しく効く。
languages(["ja","en-US"])

# 撮影対象スキーム
scheme("Calclin")

# 撮影用 UITest を明示指定する。
# 撮影は「スクショ専用の UITest ターゲット」CalclinSnapshotUITests に置く。
# こうすることで、通常の Test 実行（Cmd+U / 既存 Calc26UITests）では撮影が走らない。
# TestPlan 経由だと UITest が実行されず snapshot() が呼ばれない（結果0枚）ことがあるため、
# 撮影対象を UITest のメソッドに固定する。
only_testing(["CalclinSnapshotUITests/CalclinSnapshotUITests/testTakeScreenshots"])

# 出力先。deliver がここから拾う
output_directory("./fastlane/screenshots")

# iPhone/iPad 両方を全カット撮り直すので、古いファイルを消してクリーンに出力する。
clear_previous_screenshots(true)

# 起動を安定させる
stop_after_first_error(true)
concurrent_simulators(false)

# --- シミュレータ起動失敗（Clone の launch-failed / RequestDenied）対策 ---
# USB上のXcodeでクローン起動が拒否されることがあるため、リトライを増やす。
# 失敗が続く場合は、実行前に `xcrun simctl shutdown all` +
# `sudo killall -9 com.apple.CoreSimulator.CoreSimulatorService` でクリーンにする。
# ※ derived_data_path は付けない（固定するとクローン起動拒否で UITest が必ず失敗する）。
number_of_retries(3)
